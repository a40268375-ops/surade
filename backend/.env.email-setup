# =======================================================
# KONFIGURASI EMAIL UNTUK SISTEM OTP SURADE
# =======================================================

# Untuk Gmail SMTP (Produksi)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-gmail@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# Untuk Mailtrap (Development/Testing)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=587
# MAIL_USERNAME=your-mailtrap-username
# MAIL_PASSWORD=your-mailtrap-password
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=noreply@surade.co.id
# MAIL_FROM_NAME="${APP_NAME}"

# Untuk Log (Local Testing)
# MAIL_MAILER=log
# MAIL_HOST=127.0.0.1
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_FROM_ADDRESS="hello@example.com"
# MAIL_FROM_NAME="${APP_NAME}"

# =======================================================
# CARA SETUP GMAIL SMTP:
# =======================================================
# 1. Login ke Gmail
# 2. Ke Google Account Settings > Security
# 3. Aktifkan 2-Factor Authentication
# 4. Generate App Password:
#    - Ke "App passwords"
#    - Select app: "Mail"
#    - Select device: "Other (custom name)"
#    - Nama: "Surade Laravel"
#    - Copy generated password
# 5. Ganti MAIL_USERNAME dan MAIL_PASSWORD di .env

# =======================================================
# CARA SETUP MAILTRAP (UNTUK TESTING):
# =======================================================
# 1. Daftar di https://mailtrap.io
# 2. Buat inbox baru
# 3. Pilih Laravel integration
# 4. Copy credentials ke .env
# 5. Semua email akan masuk ke inbox Mailtrap (tidak dikirim ke email asli)

# =======================================================
# TESTING EMAIL:
# =======================================================
# Jalankan command ini untuk test konfigurasi email:
# php artisan tinker
# Mail::to('test@example.com')->send(new App\Mail\OtpMail('Test User', '123456', 'register'));